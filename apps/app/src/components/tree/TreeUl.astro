---
import Item from "./item.astro";

type It = { element: string; children: It[] };
interface Props {
  children: It[];
}
const { children } = Astro.props as Props;
---

<ul class="tree">
  {
    children.map((item) => (
      <li>
        <div class="sub-category sticky top-0 w-full">
          <Item>{item.element}</Item>
        </div>
        {item.children.length !== 0 && <Astro.self children={item.children} />}
      </li>
    ))
  }
</ul>
<style is:global>
  :root {
    --background-color: white;
    --tree-leaf-width: 40px;
    --entry-width: 15em;
    --card-width: calc(var(--entry-width) + var(--tree-leaf-width));
    --card-height: 3.5em;
    --tree-indent: calc(
      var(--entry-width) - var(--tree-leaf-width) / 2
    ); /* connector horizontal indent (to card's front) */
  }
  ul.tree,
  ul.tree ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  ul.tree ul {
    margin-left: var(--tree-indent);
  }
  ul.tree li {
    margin: 0;
    /* padding: 0 7px; */
    line-height: 20px;
    color: #369;
    font-weight: bold;
    border-left: 1px solid rgb(100, 100, 100);
  }
  ul.tree li:last-child {
    border-left: none;
  }
  .entry {
    display: flex;
    /* align-items: center; */
    height: var(--card-height);
  }
  .up {
    /* height: 1em; */
    height: 50%;
    width: var(--tree-leaf-width);
    border-bottom: 1px solid rgb(100, 100, 100);
  }
  li:last-child > .sub-category > .entry > .up {
    border-left: 1px solid rgb(100, 100, 100);
  }
  /* ul.tree li:before {
    position: relative;
    height: 1em;
    width: var(--tree-leaf-width);
    color: rgb(167, 48, 48);
    border-bottom: 1px solid rgb(100, 100, 100);
    content: "";
    display: inline-block;
  } */

  ul.tree li:last-child:before {
    border-left: 1px solid rgb(100, 100, 100);
  }

  .tree .entry {
    width: var(--entry-width);
  }
  .tree .entry .card {
    box-sizing: border-box;
    top: 0px;
    right: 0px;
    background-color: var(--background-color);
    height: var(--card-height);
    width: var(--card-width);

    border-radius: 5px;
    border: 1px solid var(--box-color);
    margin: 0;
    max-width: calc(var(--card-width) + var(--card-indent) * 0.5);
    min-width: calc(var(--card-width) + var(--card-indent) * 0.5);
    padding: 0px 5px 0px 5px;

    background: var(--background-color);
    box-shadow: var(--box-shadow);
    color: var(--connector-color);
    font-weight: bold;
    z-index: 1;
  }
</style>
